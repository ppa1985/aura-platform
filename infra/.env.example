# Copy this to infra/.env and fill in the two secrets at the bottom.
# Docker Compose auto-loads .env next to the compose file.

# ---- Ollama ----------------------------------------------------------------
# From inside containers on Docker Desktop (macOS/Windows):
OLLAMA_URL=http://host.docker.internal:11434
# From a natively-running generator:
#   OLLAMA_URL=http://localhost:11434
# On Linux Docker with a bridge network, use the host gateway IP:
#   OLLAMA_URL=http://172.17.0.1:11434

# Any model tag your Ollama has pulled. `docker exec <ollama> ollama list`
# to see what's available. llama3.1:latest and llama3.2:3b both work well.
OLLAMA_MODEL=llama3.1:latest

# ---- Deployment mode -------------------------------------------------------
# inprocess = generator just writes files; no per-app containers (lightweight)
# docker    = generator builds and runs one Next.js container per generated app
AURA_MODE=inprocess

# ---- Auth + crypto ---------------------------------------------------------
# Generate once, never commit the filled-in .env:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AURA_JWT_SECRET=replace-me-with-secrets.token_urlsafe(48)

# Generate once (Fernet key; 32 url-safe-base64 bytes):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AURA_ENCRYPTION_KEY=replace-me-with-Fernet.generate_key()

# ---- Optional --------------------------------------------------------------
# JWT lifetime (hours). 7 days default; drop to 24 in production.
# JWT_EXPIRE_HOURS=168

# Self-healing bounds (defaults are fine for laptops)
# SELF_HEAL_MAX_ATTEMPTS=3
# SELF_HEAL_TIMEOUT_SECONDS=180

# Public URL shown in the dashboard for deployed apps
# PUBLIC_BASE_URL=http://aura.local
