import Link from "next/link";
import { Button } from "@/components/ui/button";
import { Table, THead, TBody, TR, TH, TD } from "@/components/ui/table";
import { query, SCHEMA } from "@/lib/db";

export const dynamic = "force-dynamic";

type Row = Record<string, unknown> & { id: number };

async function rows(): Promise<Row[]> {
  try {
    return await query<Row>(`SELECT * FROM "${SCHEMA}"."{{ entity.table }}" ORDER BY id DESC LIMIT 100`);
  } catch {
    return [];
  }
}

export default async function {{ entity.name }}ListPage() {
  const data = await rows();
  return (
    <div className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-semibold">{{ entity.name }}s</h1>
        <Link href="/{{ entity.slug }}/new"><Button>New {{ entity.name }}</Button></Link>
      </div>
      <div className="rounded-lg border">
        <Table>
          <THead>
            <TR>
              <TH>ID</TH>
              {% for f in entity.fields %}<TH>{{ f.name }}</TH>{% endfor %}
              <TH>Actions</TH>
            </TR>
          </THead>
          <TBody>
            {data.length === 0 ? (
              <TR>
                <TD colSpan={ {{ entity.fields|length + 2 }} } className="text-center text-muted-foreground">
                  No {{ entity.name }}s yet.
                </TD>
              </TR>
            ) : (
              data.map((r) => (
                <TR key={r.id}>
                  <TD className="font-mono text-xs">{r.id}</TD>
                  {% for f in entity.fields %}
                  <TD>{String((r as Record<string, unknown>)[{{ f.name|tojson }}] ?? "")}</TD>
                  {% endfor %}
                  <TD><Link className="underline" href={`/{{ entity.slug }}/${r.id}`}>View</Link></TD>
                </TR>
              ))
            )}
          </TBody>
        </Table>
      </div>
    </div>
  );
}
